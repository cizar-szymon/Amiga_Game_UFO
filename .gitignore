/data/

# downloads, build logs, run results
/docker/cache/
/docker/*.log
/winuae/perf/
/winuae/perf-real/
/winuae/*.png
/winuae/*.pid

# Amiga binaries built from the benchmark sources
/tools/mulbench/mulbench
/tools/vrambench/copybench
/tools/vrambench/copytest
/tools/vrambench/vrambench
/tools/vrambench/movetest
/tools/vrambench/rowbench
/tools/reboot/reboot

*.cfg
*.log
*.sav
*.asav
raporty/report_img/

# release archives and their staging (tools/make_release.py)
/releases/
__pycache__/
tools/breaktask/breaktask
