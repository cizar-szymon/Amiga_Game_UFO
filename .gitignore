# Commercial / not redistributable - never in the repository
*.ROM
*.rom
winuae/boot.hdf
winuae/work/
native/cgx-include/
# game data
data/
# build leftovers
build/__pycache__/
*.pyc
*.o
*.d
# host junk
winuae/harness/_retired_host_input/
Thumbs.db

# build number, written by the build script on the host
native/amiga_buildid.h

# the PC build of MakeMusic (tools/music/make_music.py)
tools/music/.build/
tools/music/__pycache__/

# the public release tree (releases/amiga, see docs/dev/PUBLISHING.md):
# OpenXcom's own data is in it; X-COM data never - only the README files
!/releases/amiga/AmiXcom/data/
/releases/amiga/AmiXcom/data/UFO/*
!/releases/amiga/AmiXcom/data/UFO/README.txt
/releases/amiga/AmiXcom/data/TFTD/*
!/releases/amiga/AmiXcom/data/TFTD/README.txt
/releases/amiga/AmiXcom/data/UFO_AMIGA/*
!/releases/amiga/AmiXcom/data/UFO_AMIGA/README.txt
